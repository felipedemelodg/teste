        <section class="certificate c-certificate o-certificate-grid  o-main-grid__certificate">


            <div class="certificate__front c-certificate-grid__front o-certificate-grid__front ">
                <div class="certificate__details c-certificate__details">
                    <div class="certificate c-certificate__logo">
                        <img src="/src/assets/img/fsc_logo.webp" alt="FSC Segurança do trabalho logo"
                            class="certificate__logo-img">
                    </div>
                    <div class="certificate__body c-certificate__body">
                        <p>A FSC segurança do trabalho, concede este certificado a:
                        </p>
                        <h1 class="certificate__name c-certificate__name">[Nome do colaborador(a)]</h1>

                        <span class="certificate__cpf c-certificate__cpf">[CPF do colaborador(a)]</span>
                        <div class="c-certificate__text">

                            <span>Certificamos que o(a) Sr.(a)</span>
                            <span class="certificate__name-text">[Nome do colaborador(a)]</span>
                            <span>,participou do treinamento em</span>
                            <span class="certificate__training">[Nome do treinamento]</span>
                            <span>em confomidade as NR(s)</span>
                            <span class="certificate__nrs">[Numero da ou das NRs]</span>
                            <span>, na data de:</span>
                            <span class="certificate__date">[data do treinamento]</span>
                            <span>promovido por:</span>
                            <span class="certificate__institution">
                                [nome de qual instituição promovel o curso]
                            </span>
                            <span>com a carga horaria de:</span>
                            <span class="certificate__workload">
                                [carga horaria do curso]
                            </span>
                        </div>
                    </div>
                    <section class="signatures c-signatures">
                        <div class="signature c-signature signature--instructor">
                            <div class="signature__image--wrapper c-signature__image-wrapper">
                                <img alt="assinatura do instrutor" class="signature__img">
                            </div>
                            <hr>
                            <div class="signature__details c-signature__details">
                                <p class="signature__name c-signature__name">[nome do instrutor]</p>
                                <p class="signature__role c-signature__role">
                                    [qualificação e registro do instrutor]
                                </p>
                            </div>
                        </div>
                        <div class="signature c-signature signature--responsible">
                            <div class="signature__image-wrapper c-signature__image-wrapper">
                                <img alt="assinatura do responsavel" class="signature__img">
                            </div>
                            <hr>
                            <div class="signature__details c-signature__details">
                                <p class="signature__name c-signature__name">[nome do Instrutor]</p>
                                <p class="signature__role c-signature__role">
                                    [qualificação e registro do responsavel]
                                </p>
                            </div>
                        </div>
                    </section>
                </div>
                <div class="seal c-seal">
                    <div class="seal__container c-seal__container">
                        <div class="seal__image c-seal__image">
                            <img src="src/assets/img/seal-medalha.webp" alt="" class="seal__img c-seal__img">
                            <p class="c-seal__title">NR</p>
                            <p class="seal__nr c-seal__nr">
                                [numero da nr]
                            </p>
                        </div>
                    </div>
                </div>
            </div>
